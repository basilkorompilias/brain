{
  "brand_id": "lyra",
  "name": "Lyrá",
  "industry": "Travel, Hospitality & Destinations",
  "voice_words": ["serene", "sensory", "assured"],
  "reading_grade_target": {"min": 4, "max": 9},
  "sentence_length_target": {"max_avg_words": 16, "ideal_max_words": 22},
  "person": "second person or first-person plural",
  "banned_words": [
    "luxury", "luxurious", "exclusive", "world-class", "premium",
    "stunning", "amazing", "unforgettable", "best", "finest", "ultimate",
    "paradise", "hidden gem", "bucket list", "home away from home",
    "pamper", "indulge", "lavish", "opulent", "book now", "don't miss",
    "limited time", "deal", "discount", "offer", "hurry"
  ],
  "banned_patterns": [
    {"pattern": "!", "reason": "Lyrá never uses exclamation marks."},
    {"pattern": "[\\U0001F300-\\U0001FAFF]", "reason": "No emoji.", "is_regex": true},
    {"pattern": "\\b(most|very|really|super)\\b", "reason": "Avoid intensifiers and superlatives; understate instead.", "is_regex": true}
  ],
  "preferred_words": [
    "light", "salt", "stone", "shade", "horizon", "stillness", "hush",
    "ritual", "slow", "linen", "ceramic", "cellar", "cliff", "swim",
    "breath", "time", "sea", "quiet", "unhurried"
  ],
  "rules": [
    {"id": "no_exclaim", "label": "No exclamation marks", "severity": "high"},
    {"id": "short_sentences", "label": "Short, declarative sentences (avg <16 words)", "severity": "medium"},
    {"id": "no_hype", "label": "No hype, urgency or superlatives", "severity": "high"},
    {"id": "sensory", "label": "Lead with concrete, sensory nouns", "severity": "medium"},
    {"id": "show_dont_label", "label": "Show luxury through specifics; never claim it", "severity": "high"}
  ]
}
